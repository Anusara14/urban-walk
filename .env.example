# Optional. Without these the app runs in local development mode:
# posts, comments and likes are stored in this browser's IndexedDB only.
# Get both from Supabase → Project Settings → API. The anon key is public by design;
# row-level security in supabase/migrations/0001_urban_walk.sql protects the data.
# With these set, sign-in becomes "Continue with Google". Setup: docs/SUPABASE_SETUP.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Google OAuth Web Client ID (public). Enables Google's own button, so Google's screen
# shows this site instead of the Supabase URL. Same client as Supabase > Auth > Providers > Google.
# Its Authorized JavaScript origins must include this site, http://localhost and http://localhost:3000.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional. Any OpenMapTiles-schema vector style (needs building.render_height for 3D).
# Default: OpenFreeMap Positron (free, no key).
NEXT_PUBLIC_BASEMAP_STYLE=
