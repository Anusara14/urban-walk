# Optional. Without these the app runs in local development mode:
# posts, comments and likes are stored in this browser's IndexedDB only.
# Get both from Supabase → Project Settings → API. The anon key is public by design;
# row-level security in supabase/migrations/0001_urban_walk.sql protects the data.
# With these set, sign-in becomes email + 6-digit code (see the SQL file header).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Any OpenMapTiles-schema vector style (needs building.render_height for 3D).
# Default: OpenFreeMap Positron (free, no key).
NEXT_PUBLIC_BASEMAP_STYLE=
